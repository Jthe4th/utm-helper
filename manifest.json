{
  "manifest_version": 3,
  "name": "UTM Link Copier",
  "version": "0.1",
  "description": "Copy the current page or any link with UTM codes already added, for WhatsApp, Facebook, Instagram, X and YouTube.",
  "permissions": ["activeTab", "contextMenus", "storage", "clipboardWrite", "offscreen"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy link with UTM codes"
  },
  "commands": {
    "copy-last": {
      "suggested_key": { "default": "Alt+Shift+U", "mac": "Alt+Shift+U" },
      "description": "Copy this page's link for the last channel you used"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
